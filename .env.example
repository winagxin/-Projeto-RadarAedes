# String de conexão PostgreSQL (ex.: Neon em produção).
# Se ficar vazia ou não definida, o servidor usa SQLite local.
DATABASE_URL=

# Caminho opcional para o arquivo SQLite local (padrão: data/radar_aedes.db)
SQLITE_PATH=

# Defina como 1 para forçar o modo offline (Plano B com amostras locais)
RADAR_FORCE_OFFLINE=
